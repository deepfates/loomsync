      "default": "./dist/errors.js"
    },
    "./memory": {
      "types": "./dist/memory.d.ts",
      "import": "./dist/memory.js",
      "default": "./dist/memory.js"
    },
    "./events": {
      "types": "./dist/events.d.ts",
      "import": "./dist/events.js",
      "default": "./dist/events.js"
    },
    "./file-log": {
      "types": "./dist/file-log.d.ts",
      "import": "./dist/file-log.js",
      "default": "./dist/file-log.js"
    },
    "./idb-log": {
      "types": "./dist/idb-log.d.ts",
      "import": "./dist/idb-log.js",
      "default": "./dist/idb-log.js"
    },
    "./looms": {
      "types": "./dist/looms.d.ts",
