  "files": [
    "bin",
    "dist",
    "FORMAT.md",
    "RELEASE.md",
    "pacts"
  ],
  "dependencies": {},
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "pnpm build && tsc -p tsconfig.json --noEmit",
    "guard:paths": "bash scripts/no-machine-local-paths.sh",
    "verify": "pnpm guard:paths && pnpm test && pnpm typecheck && pnpm check:examples",
    "check:examples": "node scripts/check-readme-examples.mjs",
    "prepublishOnly": "tsc -p tsconfig.json"
