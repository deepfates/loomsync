  "bugs": "https://github.com/deepfates/lync/issues",
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@9.15.0",
  "bin": {
    "lync": "bin/lync.js"
  },
  "main": "./dist/index.js",
