{
  "name": "lync-workspace",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@9.15.0",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "pnpm -r build",
    "test": "vitest run",
    "typecheck": "pnpm build && pnpm -r typecheck",
    "guard:paths": "bash scripts/no-machine-local-paths.sh",
    "verify": "pnpm guard:paths && pnpm test && pnpm typecheck"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "typescript": "^5.8.3",
    "vitest": "^3.1.1",
    "lync-cli": "workspace:*"
  }
}
